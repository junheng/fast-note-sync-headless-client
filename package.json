{
  "name": "fast-note-sync-headless-client",
  "version": "2.4.0",
  "type": "module",
  "description": "Headless Node.js client for Fast Note Sync, derived from the official Obsidian plugin (implementation pending).",
  "main": "main.js",
  "scripts": {
    "dev": "npm-run-all2 --parallel devts devcss",
    "devts": "node esbuild.config.mjs",
    "devcss": "sass --watch src/styles.scss styles.css && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "fix": "eslint --fix src",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:headless": "node scripts/build-headless.mjs",
    "test:auth": "node tests/websocket-auth-error.test.mjs",
    "test:hash": "node tests/protocol-hash.test.mjs",
    "test:transport": "node tests/websocket-transport.test.mjs",
    "test:mirror": "node tests/file-mirror-restore.test.mjs",
    "test:vault-name": "node tests/vault-name-setting.test.mjs",
    "ver": "node ./scripts/update-version.js",
    "dist": "npx tsx scripts/copy-dist.ts",
    "translate": "node scripts/translate-i18n.mjs --model Qwen/Qwen3.6-35B-A3B",
    "tl": "node scripts/translate-i18n.mjs --model Qwen/Qwen3.6-35B-A3B",
    "icons": "node scripts/obfuscate_icons.js --compress --width 300",
    "proto": "pbjs -t static-module -w es6 -o src/pb/v1/sync.js ../../../../../@GoApps/fast-note-sync-service/internal/proto/v1/sync.proto && pbts -o src/pb/v1/sync.d.ts src/pb/v1/sync.js && node scripts/fix-proto.cjs",
    "test:state": "node tests/state-store.test.mjs",
    "test:sync": "node tests/identity.test.mjs && node tests/outbox.test.mjs && node tests/upload.test.mjs && node tests/reconcile.test.mjs",
    "test:filesystem": "node tests/filesystem.test.mjs",
    "test:application": "node tests/file-application.test.mjs",
    "test:conflicts": "node tests/conflicts.test.mjs",
    "test:local": "node tests/local-requests.test.mjs && node tests/local-control.test.mjs",
    "test:scan": "node tests/scanner.test.mjs",
    "test:cli": "node tests/headless-cli.test.mjs",
    "test:pull": "node tests/batch-sync.test.mjs && node tests/note-pull.test.mjs && node tests/download-batch.test.mjs && node tests/file-pull.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "long": "^5.3.2",
    "npm-run-all2": "^8.0.4",
    "obsidian": "^1.13.1",
    "protobufjs-cli": "^2.6.0",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "fflate": "^0.8.3",
    "file-type": "^21.3.4",
    "pinyin-pro": "^3.28.1",
    "protobufjs": "^8.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
  "private": true
}
