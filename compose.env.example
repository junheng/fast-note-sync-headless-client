# Copy to .local/compose.env and replace these non-secret settings.
# Optional: published image pinned by digest; omit for a local build.
# FNS_IMAGE=g1t.sigmoid.cc:53691/diomgis/fast-note-sync-headless-client@sha256:...
FNS_ENDPOINT=https://sync.example.com
FNS_VAULT=ExampleVault
FNS_LOCAL_VAULT=/absolute/path/to/vault
FNS_LOCAL_STATE=/absolute/path/to/state
FNS_LOCAL_WRITER_MODE=controlled
FNS_SYNC_INTERVAL_MS=5000
# The referenced file contains only the token; the token is not placed here.
FNS_TOKEN_HOST_FILE=/absolute/path/to/fns.token
FNS_UID=1000
FNS_GID=1000
